# /etc/ddns/ddns.env   (chmod 600)

# Cookies — one per user. Name after COOKIE_ is arbitrary, only used as a reference.
COOKIE_NAME=remember_web_...
COOKIE_DEFAULT=eyJpdiI6IkpaVG16YjZ6...


CLIENT_NAME=home-router

# COOKIE | HOST_ID | RECORD_ID | NAME [| TTL] [| TYPE] [| LABEL]
RECORD_1=DEFAULT|00000|0000000|domain.eu|1800|A
RECORD_2=DEFAULT|00000|0000000|*.domain.eu|1800|A
# in hostcreators ui, navigate to DNS and select the entry: https://www.hostcreators.sk/admin/host/domain/00000/dns/record/0000000/edit
STATE_FILE=/var/lib/ddns/state.json